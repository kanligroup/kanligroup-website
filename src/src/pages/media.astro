---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const media = (await getCollection('media')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const order = ['人物专访', '归国故事', '科研报道'];
const catDesc: Record<string, string> = {
  '人物专访': '媒体对厉侃的人物深度访谈与成长故事。',
  '归国故事': '归国任教，以及家乡、校友视角的报道。',
  '科研报道': '对代表性研究成果的报道与解读。',
};
const grouped = order
  .map((cat) => ({ cat, items: media.filter((m) => m.data.category === cat) }))
  .filter((g) => g.items.length > 0);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="相关报道 · Kan Li Group">
  <section class="block container">
    <h2 class="section">相关报道</h2>
    <p class="muted">主流媒体对厉侃教授及课题组研究的报道（按类别整理）。</p>

    {grouped.map((g) => (
      <div class="media-group">
        <h3 class="media-group-title">{g.cat} <span class="media-count">（{g.items.length}）</span></h3>
        <p class="muted media-group-desc">{catDesc[g.cat]}</p>
        <ul class="news-list">
          {g.items.map((m) => (
            <li class="news-item">
              <span class="news-date">{fmtDate(m.data.date)}</span>
              <span class="media-outlet">{m.data.outlet}</span>
              <div class="news-body">
                <a class="news-title" href={m.data.url} target="_blank" rel="noopener">{m.data.title}</a>
                {m.data.excerpt && <p class="news-excerpt">{m.data.excerpt}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>
