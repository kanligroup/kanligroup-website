---
import BaseLayout from '../layouts/BaseLayout.astro';
import scholar from '../data/scholar.json';

const fmtDate = (iso: string) => {
  const d = new Date(iso);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
};
const fetched = scholar.fetchedAt ? fmtDate(scholar.fetchedAt) : '—';
const num = (n: number | null) => (n == null ? '—' : n.toLocaleString('en-US'));
---

<BaseLayout title="关于 · Kan Li Group">
  <section class="block container">
    <span class="kicker">About</span>
    <div class="about-head">
      <img class="pi-photo" src="/people/kan-li.jpg" alt="厉侃" width="120" height="120" />
      <div>
        <h2 class="section">关于课题组</h2>
        <p class="muted">厉侃（Kan Li）教授 · 课题组负责人</p>
      </div>
    </div>
    <div class="prose">
      <p>
        厉侃（Kan Li）课题组依托华中科技大学机械科学与工程学院与智能制造装备与技术全国重点实验室，
        以<strong>理论与应用力学</strong>为统摄，围绕<strong>柔性载体上的分布式感知</strong>这一核心科学问题，
        发展柔性电子分布式感知技术，并以<strong>微飞行器作为分布式空间感知节点</strong>，
        在仿生微飞行器、曲面共形高温传感、裂纹调控传感器、柔性智能微系统等领域取得系列突破。
      </p>

      <span class="kicker">Scholar Metrics</span>
      <h3>学术指标（Google Scholar，实时数据）</h3>
      <div class="stat-grid">
        <div class="stat" style="--sc:var(--dir-blue)">
          <span class="stat-num">{num(scholar.citations)}</span>
          <span class="stat-label">总被引次数</span>
        </div>
        <div class="stat" style="--sc:var(--dir-teal)">
          <span class="stat-num">{scholar.hIndex ?? '—'}</span>
          <span class="stat-label">h-index</span>
        </div>
        <div class="stat" style="--sc:var(--dir-purple)">
          <span class="stat-num">{scholar.i10 ?? '—'}</span>
          <span class="stat-label">i10-index</span>
        </div>
      </div>
      <p class="scholar-note">
        数据更新于 {fetched} · {scholar.live ? '构建时自 Google Scholar 实时抓取' : '实时抓取失败，显示最近一次缓存'} ·
        <a href={scholar.source} target="_blank" rel="noopener">查看实时主页 ↗</a>
      </p>
      <p class="muted" style="margin-top:10px">
        近 5 年被引（自 2021）：<strong>{num(scholar.citationsSince)}</strong> 次 · 论文总数 40+ 篇 · 代表作：<em>Nature</em>（封面）、PNAS、<em>Nature Communications</em>、<em>Science Advances</em>、<em>Advanced Materials</em> 等
      </p>

      <h3>荣誉获奖</h3>
      <ol>
        <li>2021 — 国家自然科学基金优秀青年科学基金（海外）</li>
        <li>2021 — 东湖青年学者</li>
        <li>2017 — 国家优秀自费留学生奖学金</li>
        <li>2009 — 全国中学生物理竞赛（CPhO）金牌</li>
      </ol>

      <h3>合作导师</h3>
      <ul>
        <li><strong>黄永刚 院士</strong> — 西北大学 / 清华大学（博士导师）</li>
        <li><strong>John A. Rogers 院士</strong> — 西北大学（合作导师）</li>
        <li><strong>Norman A. Fleck 院士</strong> — 剑桥大学（博士后导师）</li>
      </ul>

      <p>
        <strong>联系：</strong>
        <a href="mailto:kanli@hust.edu.cn">kanli@hust.edu.cn</a> &nbsp;·&nbsp;
        办公地点：先进制造大楼东楼 D301 &nbsp;·&nbsp;
        地址：湖北省武汉市洪山区珞喻路 1037 号
      </p>
    </div>

    <figure class="group-photo">
      <img src="/group-photo-2026.jpg" alt="课题组合影 2026 · 华中科技大学" loading="lazy" />
      <figcaption>
        课题组合影（2026 年，华中科技大学）· 注：吕莹、张浩未参加本次合影
        <span class="roster">
          前排（左→右）：朱彦臣、谢宏伟、韩炎岐、袁理、厉侃、何定峰、吴萱雨、曾翀、耿秀侠
          后排（左→右）：刘奕辰、廖酩苍、许子健、侯超、令景辉、潘津羽、肖龙海
        </span>
      </figcaption>
    </figure>
  </section>
</BaseLayout>
