---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="最新进展 · Kan Li Group">
  <section class="block container">
    <h2 class="section">最新进展</h2>
    <p class="muted">课题组前沿要闻与研究动态。</p>
    <ul class="news-list">
      {news.map((n) => (
        <li class="news-item">
          <span class="news-date">{fmtDate(n.data.date)}</span>
          {n.data.tag && <span class="news-tag">{n.data.tag}</span>}
          <div class="news-body">
            <a class="news-title" href={n.data.link || '#'}>{n.data.title}</a>
            {n.data.excerpt && <p class="news-excerpt">{n.data.excerpt}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
