---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectionTree from '../components/DirectionTree.astro';
---

<BaseLayout title="研究方向 · Kan Li Group">
  <section class="block container">
    <span class="kicker">Core Questions</span>
    <h2 class="section">核心科学问题</h2>
    <div class="prose">
      <p class="lead-question">
        当载体柔软、曲面、甚至在空中翻飞时——<br />
        如何让它依然"感知"世界，并与同伴协同？
      </p>
      <p class="framing">
        柔性电子的本质，是一个力学问题：它的电学功能，取决于结构在力、热、电多场耦合下的形变与精确调控。我们围绕<strong>"柔性载体上的分布式感知"</strong>这一核心，发展三类相互支撑的能力，共同构成面向 Physical AI 的感知基础设施——
      </p>
    </div>

    <div class="q-grid">
      <article class="q-card reveal" style="--qc:#1a4d8f;--qc-soft:#eaf1fa">
        <h3>柔性电子微飞行器</h3>
        <p class="q-kicker">分布式空间感知节点</p>
        <ul class="q-list">
          <li class="q-item">如何设计、制备更轻、更小、飞得更久的微飞行器？</li>
          <li class="q-item">如何实现毫米、微米尺度微飞的主动控制？</li>
        </ul>
      </article>

      <article class="q-card reveal" style="--qc:#0f6e58;--qc-soft:#e6f2ef">
        <h3>耐高温柔性多模态传感器</h3>
        <p class="q-kicker">极端环境结构监测</p>
        <ul class="q-list">
          <li class="q-item">如何在数百摄氏度高温下，依然稳定地感知压力、温度与应变？</li>
          <li class="q-item">如何让柔性薄膜传感器共形贴附于发动机曲面？</li>
        </ul>
      </article>

      <article class="q-card reveal" style="--qc:#7c3aed;--qc-soft:#f1ebfd">
        <h3>柔性智能微系统</h3>
        <p class="q-kicker">人–机–环融合终端</p>
        <ul class="q-list">
          <li class="q-item">如何把感知、通信、驱动压进纤维与软体，实现人–机–环融合？</li>
          <li class="q-item">如何让柔性电子从"能感知"走向"能思考、能行动"？</li>
          <li class="q-item">如何让一群微飞自组织，涌现出群体智能？</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="block container">
    <span class="kicker">Architecture</span>
    <h2 class="section">研究方向架构</h2>
    <div class="tree-figure">
      <DirectionTree />
      <p class="tree-caption">
        图　以理论与应用力学为统摄的研究方向架构：三个相互支撑的能力方向，及其面向 Physical AI 的典型应用场景。
      </p>
    </div>
  </section>

  <style>
    .framing {
      max-width: 780px;
      color: var(--text);
      font-size: 15.5px;
      line-height: 1.75;
      margin: 0 0 4px;
    }
    .q-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin: 28px 0 6px;
    }
    .q-card {
      position: relative;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      padding: 22px 20px 20px;
      overflow: hidden;
      transition: transform .35s var(--ease-out-expo), box-shadow .35s var(--ease-out-expo), border-color .35s var(--ease-out-expo);
    }
    .q-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: var(--qc);
    }
    .q-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: color-mix(in srgb, var(--qc) 35%, var(--line));
    }
    .q-card h3 {
      margin: 0 0 3px;
      font-size: 17px;
      font-weight: 800;
      color: var(--qc);
      letter-spacing: -0.01em;
    }
    .q-kicker {
      margin: 0 0 16px;
      font-size: 12.5px;
      color: var(--muted);
      letter-spacing: 0.01em;
    }
    .q-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }
    .q-item {
      position: relative;
      padding-left: 30px;
      font-size: 14.5px;
      line-height: 1.62;
      color: var(--text);
    }
    .q-item::before {
      content: "?";
      position: absolute;
      left: 0;
      top: 1px;
      width: 21px;
      height: 21px;
      border-radius: 50%;
      background: var(--qc-soft);
      color: var(--qc);
      font-weight: 800;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @media (max-width: 860px) {
      .q-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
