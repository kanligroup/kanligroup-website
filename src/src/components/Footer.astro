---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { href: '/research', key: 'nav.research' },
  { href: '/people', key: 'nav.people' },
  { href: '/publications', key: 'nav.publications' },
  { href: '/admissions', key: 'nav.admissions' },
  { href: '/about', key: 'nav.about' },
];
const year = new Date().getFullYear();
const brandSuffix = locale === 'en' ? '· Kan Li Group' : '· 厉侃课题组';
---

<footer class="site">
  <div class="container footer-inner">
    <div>
      <p class="f-brand">
        <img class="f-mark" src="/logo.svg" alt="" width="22" height="22" aria-hidden="true" />
        Kan Li Group {brandSuffix}
      </p>
      <p class="muted">{t('footer.tagline')}</p>
    </div>
    <nav class="f-links" aria-label={locale === 'en' ? 'Footer navigation' : '页脚导航'}>
      {links.map((l) => <a href={getRelativeLocaleUrl(locale, l.href)}>{t(l.key)}</a>)}
    </nav>
  </div>
  <div class="container">
    <p class="muted f-copy">© {year} Kan Li Group · {t('footer.copy')} · kanligroup.com</p>
  </div>
</footer>
