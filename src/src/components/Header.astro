---
const nav = [
  { href: '/', label: '首页' },
  { href: '/research', label: '研究方向' },
  { href: '/people', label: '团队成员' },
  { href: '/publications', label: '研究成果' },
  { href: '/news', label: '最新进展' },
  { href: '/admissions', label: '招生' },
  { href: '/about', label: '关于' },
];
const path = Astro.url.pathname;
---

<header class="site">
  <div class="container">
    <a class="logo" href="/">Kan Li Group</a>
    <nav>
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
