---
// 标志性研究：三个方向的真实图片/视频素材，替代原示意性卡通插画。
// 每个方向对应一组媒体（图片 / 视频），在首页研究方向区块以 2-up 网格呈现。
// 素材文件保留在 public/gallery/ 下，未做删除。
const figures = [
  {
    title: "柔性电子微飞行器",
    caption: "受风传种子启发的三维微飞行器，可集成感知–通信–驱动，构建分布式空间感知节点（Nature 2021 封面）。",
    color: "#1a4d8f",
    soft: "#eaf1fa",
    media: [
      { type: "image", src: "/gallery/img/nature-cover.png", alt: "Nature 封面 — 仿风传种子三维微电子飞行器", label: "Nature 封面 (2021)", contain: true },
      { type: "video", src: "/gallery/vid/flight-demo.mp4", alt: "微飞行器下落飞行演示", label: "微飞行器下落演示" },
    ],
  },
  {
    title: "耐高温柔性多模态传感器",
    caption: "共形于发动机热端与复杂曲面的柔性多模态传感，面向极端环境结构健康监测。",
    color: "#0f6e58",
    soft: "#e6f2ef",
    media: [
      { type: "video", src: "/gallery/vid/ht-sensor-1.mp4", alt: "耐高温柔性传感器演示（一）", label: "耐高温传感器演示（一）" },
      { type: "video", src: "/gallery/vid/ht-sensor-2.mp4", alt: "耐高温柔性传感器演示（二）", label: "耐高温传感器演示（二）" },
    ],
  },
  {
    title: "柔性智能微系统",
    caption: "纤维电子、软体驱动与神经接口融合的柔性智能微系统，实现人–机–环协同。",
    color: "#7c3aed",
    soft: "#f1ebfd",
    media: [
      { type: "image", src: "/gallery/img/system-overview.png", alt: "系统集成架构全貌 — 感知–通信–驱动一体化", label: "系统集成 · 感知–通信–驱动", contain: true },
      { type: "image", src: "/gallery/img/swarm-flight.png", alt: "微飞行器群体智能 — 分布式感知节点", label: "群体智能" },
    ],
  },
];
---

<div class="fig-grid">
  {
    figures.map((f) => (
      <figure class="fig-card reveal" style={`--fc:${f.color};--fs:${f.soft}`}>
        <div class="fig-media">
          {f.media.map((m) => (
            <div class="tile">
              {m.type === "video" ? (
                <video class="tile-media" autoplay muted loop playsinline controls preload="metadata" aria-label={m.alt}>
                  <source src={m.src} type="video/mp4" />
                  您的浏览器不支持视频播放。
                </video>
              ) : (
                <img class={`tile-media${m.contain ? " tile-contain" : ""}`} src={m.src} alt={m.alt} loading="lazy" />
              )}
              <span class="tile-cap">{m.label}</span>
            </div>
          ))}
        </div>
        <figcaption class="fig-body">
          <h3>{f.title}</h3>
          <p>{f.caption}</p>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .fig-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
    margin: 22px 0 6px;
  }
  .fig-card {
    margin: 0;
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .fig-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--fc);
  }
  .fig-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: #c9d8ec;
  }
  .fig-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 10px 10px 4px;
    background: var(--fs);
  }
  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 10px;
  }
  .tile-media {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    background: #0c1320;
    border-radius: 10px;
    border: 1px solid rgba(16, 32, 56, .06);
    transition: transform .5s cubic-bezier(.22,.61,.36,1);
  }
  .tile:hover .tile-media { transform: scale(1.035); }
  video.tile-media:focus-visible {
    outline: 2px solid var(--fc);
    outline-offset: 2px;
  }
  /* 完整显示（不裁切）：如 Nature 封面等竖版/特殊比例图，居中留白 */
  img.tile-contain {
    object-fit: contain;
    background: #ffffff;
    border-color: rgba(16, 32, 56, .1);
  }
  .tile-cap {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
    text-align: center;
    padding: 0 2px;
  }
  .fig-body { padding: 14px 18px 20px; }
  .fig-body h3 {
    margin: 0 0 7px;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--fc);
  }
  .fig-body p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--text);
  }
  @media (max-width: 560px) {
    .fig-media { grid-template-columns: 1fr; }
    .tile-media { aspect-ratio: 16 / 9; }
  }
</style>
