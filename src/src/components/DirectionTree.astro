---
// 研究方向架构图：核心科学问题为根，分三个方向；
// 每个方向框内列出子方向、团队成员（彩色 pill）与代表论文（期刊名+年份）；
// 底部「应用场景」一行对应三个方向。
// 成员与论文均从 collection 动态计算，避免与页面其它处不一致。
import { getCollection } from 'astro:content';

const PRIMARY = "#1a4d8f";
const LINE = "#c2cedd";
const DARK = "#1f2d3d";
const MUTED = "#5b6b7b";

// 三个方向各自的配色（蓝 / 青绿 / 紫），用于顶条、子项圆点、成员 pill、应用场景强调
const palette = [
  { main: "#1a4d8f", soft: "#eaf1fa", soft2: "#f5f9fd" },
  { main: "#0f6e58", soft: "#e6f2ef", soft2: "#f3faf8" },
  { main: "#7c3aed", soft: "#f1ebfd", soft2: "#faf7fe" },
];

const members = await getCollection('members');
const publications = await getCollection('publications');

// 按方向取在读学生姓名（不含 PI）
const namesFor = (title: string) =>
  members
    .filter((m) => m.data.direction === title && !m.data.is_pi)
    .map((m) => m.data.name);

// 按方向取代表论文，按年份倒序
const pubsFor = (title: string) =>
  publications
    .filter((p) => p.data.direction === title)
    .sort((a, b) => b.data.year - a.data.year);

// 期刊名缩写表（长名用通用缩写，短名保留原文）
const VENUE_SHORT: Record<string, string> = {
  "Nature": "Nature",
  "Nature Communications": "Nat. Commun.",
  "Science Advances": "Sci. Adv.",
  "Science Translational Medicine": "Sci. Transl. Med.",
  "Proceedings of the National Academy of Sciences": "PNAS",
  "Nature Biomedical Engineering": "Nat. Biomed. Eng.",
  "Nano Energy": "Nano Energy",
  "Materials Today": "Mater. Today",
  "Nano-Micro Letters": "Nano-Micro Lett.",
  "Rare Metals": "Rare Metals",
  "Acta Automatica Sinica": "Acta Autom. Sinica",
  "International Journal of Mechanical Sciences": "Int. J. Mech. Sci.",
  "Mathematics and Mechanics of Complex Systems": "Math. Mech. Complex Syst.",
  "High-Temperature Materials": "High-Temp. Mater.",
  "Discover Sensors": "Discover Sensors",
  "Advanced Materials Technologies": "Adv. Mater. Technol.",
  "Programmable Materials": "Programmable Mater.",
  "NPJ Digital Medicine": "npj Digit. Med.",
  "Advanced Functional Materials": "Adv. Funct. Mater.",
  "Advanced Materials": "Adv. Mater.",
  "View": "View",
  "Small": "Small",
  "Research": "Research",
};
const venueShort = (v: string) => VENUE_SHORT[v] ?? v;
const pubLabel = (p: { data: { venue: string; year: number } }) =>
  `${venueShort(p.data.venue)} ${p.data.year}`;

// 成员 pill 布局：贪心换行
const CHIP_FONT = 14.5;
const CHIP_PAD_X = 12;
const CHIP_H = 27;
const CHIP_GAP_X = 8;
const CHIP_GAP_Y = 8;
const BW_CONTENT = 308; // 框内可用宽度

function chipWidth(name: string): number {
  return name.length * CHIP_FONT + CHIP_PAD_X * 2;
}

// 论文条目布局：用「·」分隔，按可用宽度贪心换行
const PUB_FONT = 14.5;
const PUB_CHAR_W = 8.0;
const PUB_SEP = "  ·  ";
const PUB_SEP_W = PUB_SEP.length * PUB_CHAR_W;
const PUB_LINE_H = 22;

function wrapPubs(items: string[]): string[][] {
  const lines: string[][] = [];
  let cur: string[] = [];
  let curW = 0;
  for (const it of items) {
    const w = it.length * PUB_CHAR_W;
    const add = (cur.length ? PUB_SEP_W : 0) + w;
    if (cur.length && curW + add > BW_CONTENT) {
      lines.push(cur);
      cur = [];
      curW = 0;
    }
    cur.push(it);
    curW += (cur.length > 1 ? PUB_SEP_W : 0) + w;
  }
  if (cur.length) lines.push(cur);
  return lines;
}

const tree = {
  root: { title: "核心科学问题", sub: "以理论与应用力学为统摄 · 柔性载体上的分布式感知" },
  branches: [
    {
      title: "柔性电子微飞行器",
      sub: [
        "仿生三维微飞行器结构设计",
        "飞行力学与主动调控",
        "感知–通信–驱动一体化系统集成",
        "无线组网与低功耗图传",
      ],
      scenario: {
        lead: "空地协同感知节点",
        points: [
          "临近空间分布式组网",
          "星球探测感知前端",
          "环境监测与污染吸附",
        ],
      },
    },
    {
      title: "耐高温柔性多模态传感器",
      sub: [
        "多参量分布式感知",
        "压力阵列化感知",
        "纳米尺度效应及原位感知",
        "柔性PZT薄膜压电传感",
        "柔性多模态传感",
        "柔性蒙皮",
      ],
      scenario: {
        lead: "极端环境结构监测",
        points: [
          "航空发动机热端监测",
          "水星/木星极端探测",
          "核工业与工业监测",
        ],
      },
    },
    {
      title: "柔性智能微系统",
      sub: [
        "摩擦纳米发电机纤维",
        "柔性混合传感与无线定位",
        "模块化柔性机器人与软体驱动",
        "侵入式脑机接口",
        "旋翼健康监测（韩炎岐）",
      ],
      scenario: {
        lead: "人–机–环融合终端",
        points: [
          "可穿戴/植入健康监测",
          "软体机器人感驱一体",
          "神经接口与康复",
        ],
      },
    },
  ],
};

// 补全每个分支：配色、成员 pill 布局、代表论文换行
tree.branches.forEach((b, i) => {
  const names = namesFor(b.title);
  b.count = names.length;
  b.color = palette[i];

  const chips: { x: number; y: number; w: number; label: string }[] = [];
  let cx = 18;
  let cy = 0;
  let maxY = 0;
  names.forEach((n) => {
    const w = chipWidth(n);
    if (cx + w > 18 + BW_CONTENT && chips.length > 0) {
      cx = 18;
      cy += CHIP_H + CHIP_GAP_Y;
      maxY = cy;
    }
    chips.push({ x: cx, y: cy, w, label: n });
    cx += w + CHIP_GAP_X;
  });
  b.chips = chips;
  b.chipRows = names.length ? maxY / (CHIP_H + CHIP_GAP_Y) + 1 : 0;

  const items = pubsFor(b.title).map(pubLabel);
  b.pubLines = wrapPubs(items);
});

// 布局常量
const W = 1120;
const BW = 344;
const GAP = (W - BW * 3) / 4;
const ROOT_W = 580;
const ROOT_X = (W - ROOT_W) / 2;
const ROOT_Y = 28;
const ROOT_H = 92;
const BUS_Y = 168;
const BRANCH_Y = 236;
const HEADER_H = 60;
const SUB_ITEM_H = 30;
const FIRST_SUB_BASE = HEADER_H + 25;   // 第一个子方向文字基线
const DIVIDER_OFF = 10;
const LABEL_OFF = 26;                    // 分区标签相对分隔线的偏移
const BOTTOM_PAD = 16;

const xs = tree.branches.map((_, i) => GAP + i * (BW + GAP));
const centers = tree.branches.map((_, i) => xs[i] + BW / 2);

// 逐段计算每个分支的纵向布局（子方向 → 团队成员 → 发表论文）
const heights = tree.branches.map((b) => {
  const dividerY = HEADER_H + b.sub.length * SUB_ITEM_H + DIVIDER_OFF;
  const labelY = dividerY + LABEL_OFF;
  const chipsTop = labelY + 12;
  const chipsBottom = chipsTop + (b.chipRows > 0 ? b.chipRows * CHIP_H + (b.chipRows - 1) * CHIP_GAP_Y : 0);
  let bottom = chipsBottom;
  const layout: any = { dividerY, labelY, chipsTop, chipsBottom };
  if (b.pubLines.length > 0) {
    const pubsDividerY = chipsBottom + 16;
    const pubsLabelY = pubsDividerY + LABEL_OFF;
    const pubsTop = pubsLabelY + 22;
    const pubsBottom = pubsTop + b.pubLines.length * PUB_LINE_H;
    layout.pubsDividerY = pubsDividerY;
    layout.pubsLabelY = pubsLabelY;
    layout.pubsTop = pubsTop;
    bottom = pubsBottom;
  }
  b.layout = layout;
  return bottom + BOTTOM_PAD;
});
const maxBranchH = Math.max(...heights);

// 应用场景行
const SCEN_LEAD_Y = 32;
const SCEN_POINT_TOP = 52;
const SCEN_POINT_H = 26;
const SCEN_LABEL_Y = BRANCH_Y + maxBranchH + 44;
const SCEN_BOX_Y = SCEN_LABEL_Y + 30;
const maxPoints = Math.max(...tree.branches.map((b) => b.scenario.points.length));
const SCEN_BOX_H = SCEN_POINT_TOP + maxPoints * SCEN_POINT_H + 14;

const H = SCEN_BOX_Y + SCEN_BOX_H + 28;
---

<svg
  class="dir-tree"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="研究方向架构图"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="rootGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#16458a" />
      <stop offset="100%" stop-color="#2b6fb5" />
    </linearGradient>
    <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#1f2d3d" flood-opacity="0.14" />
    </filter>
    <filter id="lightShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#1f2d3d" flood-opacity="0.10" />
    </filter>
  </defs>

  <!-- 背景面板 -->
  <rect x="0" y="0" width={W} height={H} rx="18" fill="#f7f9fc" stroke="#eaeef4" stroke-width="1" />

  <!-- 连接线 -->
  <g stroke={LINE} stroke-width="2.5" fill="none" stroke-linecap="round">
    <line x1={W / 2} y1={ROOT_Y + ROOT_H} x2={W / 2} y2={BUS_Y} />
    <line x1={centers[0]} y1={BUS_Y} x2={centers[centers.length - 1]} y2={BUS_Y} />
    {centers.map((cx) => <line x1={cx} y1={BUS_Y} x2={cx} y2={BRANCH_Y} />)}
    {centers.map((cx) => <line x1={cx} y1={BRANCH_Y + maxBranchH} x2={cx} y2={SCEN_BOX_Y} />)}
  </g>
  <!-- 连接节点圆点 -->
  <g fill={PRIMARY}>
    <circle cx={W / 2} cy={BUS_Y} r="4.5" />
    {centers.map((cx) => <circle cx={cx} cy={BUS_Y} r="4.5" />)}
    {centers.map((cx) => <circle cx={cx} cy={BRANCH_Y} r="4.5" />)}
  </g>

  <!-- 根节点 -->
  <g filter="url(#softShadow)">
    <rect x={ROOT_X} y={ROOT_Y} width={ROOT_W} height={ROOT_H} rx="14" fill="url(#rootGrad)" />
  </g>
  <text x={W / 2} y={ROOT_Y + 42} text-anchor="middle" fill="#fff" font-size="30" font-weight="700">
    {tree.root.title}
  </text>
  <text x={W / 2} y={ROOT_Y + 72} text-anchor="middle" fill="#dbe7f6" font-size="17">
    {tree.root.sub}
  </text>

  <!-- 三个方向框 -->
  {
    tree.branches.map((b, i) => {
      const col = b.color;
      const L = b.layout;
      return (
        <g transform={`translate(${xs[i]}, ${BRANCH_Y})`}>
          <g filter="url(#lightShadow)">
            <rect x="0" y="0" width={BW} height={maxBranchH} rx="14" fill="#fff" stroke={col.main} stroke-width="1.5" />
          </g>
          {/* 顶部色条 */}
          <path d={`M0 14 Q0 0 14 0 L${BW - 14} 0 Q${BW} 0 ${BW} 14 L${BW} 6 L0 6 Z`} fill={col.main} />
          {/* 标题区 */}
          <text x="20" y="36" fill={col.main} font-size="23" font-weight="700">{b.title}</text>
          <text x="20" y="55" fill={MUTED} font-size="15.5">{b.count} 名成员</text>

          {/* 子方向 */}
          {b.sub.map((s, j) => (
            <g transform={`translate(0, ${FIRST_SUB_BASE - 5 + j * SUB_ITEM_H})`}>
              <circle cx="24" cy="5" r="4.5" fill={col.main} />
              <text x="38" y="11" fill={DARK} font-size="17.5">{s}</text>
            </g>
          ))}

          {/* 团队成员 */}
          <line x1="16" y1={L.dividerY} x2={BW - 16} y2={L.dividerY} stroke={LINE} stroke-width="1" />
          <text x="18" y={L.labelY} fill={col.main} font-size="16" font-weight="700">团队成员</text>
          {b.chips.map((c) => (
            <g>
              <rect x={c.x} y={L.chipsTop + c.y} width={c.w} height={CHIP_H} rx={CHIP_H / 2} fill={col.soft} stroke={col.main} stroke-width="1" stroke-opacity="0.45" />
              <text x={c.x + c.w / 2} y={L.chipsTop + c.y + CHIP_H / 2 + 4.5} text-anchor="middle" fill={col.main} font-size={CHIP_FONT} font-weight="600">{c.label}</text>
            </g>
          ))}

          {/* 发表论文 */}
          {b.pubLines.length > 0 && (
            <g>
              <line x1="16" y1={L.pubsDividerY} x2={BW - 16} y2={L.pubsDividerY} stroke={LINE} stroke-width="1" />
              <text x="18" y={L.pubsLabelY} fill={col.main} font-size="16" font-weight="700">发表论文</text>
              {b.pubLines.map((line, k) => (
                <text x="18" y={L.pubsTop + k * PUB_LINE_H} fill={DARK} font-size={PUB_FONT}>{line.join(PUB_SEP)}</text>
              ))}
            </g>
          )}
        </g>
      );
    })
  }

  {/* 应用场景行 */}
  <text x={W / 2} y={SCEN_LABEL_Y} text-anchor="middle" fill="#334155" font-size="21" font-weight="700">应用场景</text>
  {
    tree.branches.map((b, i) => {
      const col = b.color;
      return (
        <g transform={`translate(${xs[i]}, ${SCEN_BOX_Y})`}>
          <g filter="url(#lightShadow)">
            <rect x="0" y="0" width={BW} height={SCEN_BOX_H} rx="14" fill={col.soft2} stroke={col.main} stroke-width="1.5" />
          </g>
          <line x1="15" y1="16" x2="15" y2={SCEN_BOX_H - 16} stroke={col.main} stroke-width="3.5" stroke-linecap="round" />
          <text x="28" y={SCEN_LEAD_Y} fill={col.main} font-size="16.5" font-weight="700">{b.scenario.lead}</text>
          {b.scenario.points.map((p, k) => (
            <g transform={`translate(0, ${SCEN_POINT_TOP + k * SCEN_POINT_H})`}>
              <circle cx="32" cy="5" r="3.5" fill={col.main} />
              <text x="42" y="11" fill={DARK} font-size="15">{p}</text>
            </g>
          ))}
        </g>
      );
    })
  }
</svg>

<style>
  .dir-tree {
    width: 100%;
    height: auto;
    max-width: 1040px;
    margin: 8px auto 8px;
    display: block;
  }
</style>
