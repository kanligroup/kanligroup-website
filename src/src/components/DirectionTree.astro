---
// 研究方向架构图：核心科学问题为根，分三个方向；
// 每个方向框内列出子方向、团队成员（彩色 pill）与代表论文（期刊名+年份）；
// 底部「应用场景」一行对应三个方向。
// 成员与论文均从 collection 动态计算，避免与页面其它处不一致。
//
// 注意：SVG <text> 不自动换行，英文子项/标题经常超出框宽。
// 这里用 wrapLabel() 在构建期按可用宽度折行，并据实际行数动态计算纵向布局，
// 确保中英文都不会溢出方向框。
import { getCollection } from 'astro:content';
import { getLocaleFromUrl } from '../i18n/utils';
import { memberEn } from '../i18n/content';

const locale = getLocaleFromUrl(Astro);
const isEn = locale === 'en';

const PRIMARY = "#1a4d8f";
const LINE = "#c2cedd";
const DARK = "#1f2d3d";
const MUTED = "#5b6b7b";

// 三个方向各自的配色（蓝 / 青绿 / 紫），用于顶条、子项圆点、成员 pill、应用场景强调
const palette = [
  { main: "#1a4d8f", soft: "#eaf1fa", soft2: "#f5f9fd" },
  { main: "#0f6e58", soft: "#e6f2ef", soft2: "#f3faf8" },
  { main: "#7c3aed", soft: "#f1ebfd", soft2: "#faf7fe" },
];

const members = await getCollection('members');
const publications = await getCollection('publications');

// 按方向取在读学生姓名（不含 PI）——英文版取罗马化姓名
const namesFor = (title: string) =>
  members
    .filter((m) => m.data.direction === title && !m.data.is_pi)
    .map((m) => (isEn ? (memberEn[m.slug]?.name ?? m.data.name) : m.data.name));

// 按方向取代表论文，按年份倒序
const pubsFor = (title: string) =>
  publications
    .filter((p) => p.data.direction === title)
    .sort((a, b) => b.data.year - a.data.year);

// 期刊名缩写表（长名用通用缩写，短名保留原文）
const VENUE_SHORT: Record<string, string> = {
  "Nature": "Nature",
  "Nature Communications": "Nat. Commun.",
  "Science Advances": "Sci. Adv.",
  "Science Translational Medicine": "Sci. Transl. Med.",
  "Proceedings of the National Academy of Sciences": "PNAS",
  "Nature Biomedical Engineering": "Nat. Biomed. Eng.",
  "Nano Energy": "Nano Energy",
  "Materials Today": "Mater. Today",
  "Nano-Micro Letters": "Nano-Micro Lett.",
  "Rare Metals": "Rare Metals",
  "Acta Automatica Sinica": "Acta Autom. Sinica",
  "International Journal of Mechanical Sciences": "Int. J. Mech. Sci.",
  "Mathematics and Mechanics of Complex Systems": "Math. Mech. Complex Syst.",
  "High-Temperature Materials": "High-Temp. Mater.",
  "Discover Sensors": "Discover Sensors",
  "Advanced Materials Technologies": "Adv. Mater. Technol.",
  "Programmable Materials": "Programmable Mater.",
  "NPJ Digital Medicine": "npj Digit. Med.",
  "Advanced Functional Materials": "Adv. Funct. Mater.",
  "Advanced Materials": "Adv. Mater.",
  "View": "View",
  "Small": "Small",
  "Research": "Research",
};
const venueShort = (v: string) => VENUE_SHORT[v] ?? v;
const pubLabel = (p: { data: { venue: string; year: number } }) =>
  `${venueShort(p.data.venue)} ${p.data.year}`;

// ---- 文字折行工具 ----
// SVG <text> 不会自动换行，这里在构建期按近似字宽折行，避免英文溢出框外。
// CJK 字符较宽但通常单行即可放下（方向名/子项都较短），故 CJK 直接返回整行。
function wrapLabel(text: string, maxW: number, fs: number): string[] {
  if (/[一-鿿]/.test(text)) return [text];
  const perChar = fs * 0.60; // 保守字宽估算（Sora 偏宽，留余量）
  const words = String(text).split(' ');
  const lines: string[] = [];
  let cur = '';
  for (const w of words) {
    const trial = cur ? cur + ' ' + w : w;
    if (cur && trial.length * perChar > maxW) {
      lines.push(cur);
      cur = w;
    } else {
      cur = trial;
    }
  }
  if (cur) lines.push(cur);
  return lines.length ? lines : [text];
}

// 成员 pill 布局：贪心换行
const CHIP_FONT = 14.5;
const CHIP_PAD_X = 12;
const CHIP_H = 27;
const CHIP_GAP_X = 8;
const CHIP_GAP_Y = 8;
const BW_CONTENT = 308; // 框内可用宽度

function chipWidth(name: string): number {
  return name.length * CHIP_FONT + CHIP_PAD_X * 2;
}

// 论文条目布局：用「·」分隔，按可用宽度贪心换行
const PUB_FONT = 14.5;
const PUB_CHAR_W = 8.0;
const PUB_SEP = "  ·  ";
const PUB_SEP_W = PUB_SEP.length * PUB_CHAR_W;
const PUB_LINE_H = 22;

function wrapPubs(items: string[]): string[][] {
  const lines: string[][] = [];
  let cur: string[] = [];
  let curW = 0;
  for (const it of items) {
    const w = it.length * PUB_CHAR_W;
    const add = (cur.length ? PUB_SEP_W : 0) + w;
    if (cur.length && curW + add > BW_CONTENT) {
      lines.push(cur);
      cur = [];
      curW = 0;
    }
    cur.push(it);
    curW += (cur.length > 1 ? PUB_SEP_W : 0) + w;
  }
  if (cur.length) lines.push(cur);
  return lines;
}

const treeZh = {
  root: { title: "核心科学问题", sub: "以理论与应用力学为统摄 · 柔性载体上的分布式感知" },
  branches: [
    {
      title: "柔性电子微飞行器",
      sub: [
        "仿生三维微飞行器结构设计",
        "飞行力学与主动调控",
        "感知–通信–驱动一体化系统集成",
        "无线组网与低功耗图传",
      ],
      scenario: {
        lead: "空地协同感知节点",
        points: [
          "临近空间分布式组网",
          "星球探测感知前端",
          "环境监测与污染吸附",
        ],
      },
    },
    {
      title: "耐高温柔性多模态传感器",
      sub: [
        "多参量分布式感知",
        "压力阵列化感知",
        "纳米尺度效应及原位感知",
        "柔性PZT薄膜压电传感",
        "柔性多模态传感",
        "柔性蒙皮",
      ],
      scenario: {
        lead: "极端环境结构监测",
        points: [
          "航空发动机热端监测",
          "水星/木星极端探测",
          "核工业与工业监测",
        ],
      },
    },
    {
      title: "柔性智能微系统",
      sub: [
        "摩擦纳米发电机纤维",
        "柔性混合传感与无线定位",
        "模块化柔性机器人与软体驱动",
        "侵入式脑机接口",
        "旋翼健康监测（韩炎岐）",
      ],
      scenario: {
        lead: "人–机–环融合终端",
        points: [
          "可穿戴/植入健康监测",
          "软体机器人感驱一体",
          "神经接口与康复",
        ],
      },
    },
  ],
};

const treeEn = {
  root: { title: "Core Scientific Questions", sub: "Grounded in theoretical and applied mechanics · Distributed sensing on flexible substrates" },
  branches: [
    {
      title: "Flexible Electronic Microfliers",
      sub: [
        "Bio-inspired 3D microflier structural design",
        "Flight mechanics and active control",
        "Sensing–communication–actuation system integration",
        "Wireless networking and low-power video",
      ],
      scenario: {
        lead: "Air–ground cooperative sensing nodes",
        points: [
          "Near-space distributed networking",
          "Planetary-exploration sensing front-ends",
          "Environmental monitoring and pollutant capture",
        ],
      },
    },
    {
      title: "High-Temperature Flexible Multimodal Sensors",
      sub: [
        "Multi-parameter distributed sensing",
        "Pressure-array sensing",
        "Nanoscale effects and in-situ sensing",
        "Flexible PZT thin-film piezoelectric sensing",
        "Flexible multimodal sensing",
        "Flexible skin and conformal surfaces",
      ],
      scenario: {
        lead: "Extreme-environment structural monitoring",
        points: [
          "Aero-engine hot-section monitoring",
          "Mercury and Jupiter extreme-environment exploration",
          "Nuclear and industrial monitoring",
        ],
      },
    },
    {
      title: "Flexible Intelligent Microsystems",
      sub: [
        "Triboelectric nanogenerator fibers",
        "Flexible hybrid sensing and wireless localization",
        "Modular flexible robots and soft actuation",
        "Invasive brain–computer interfaces",
        "Rotor health monitoring (Y. Han)",
      ],
      scenario: {
        lead: "Human–machine–environment fusion terminals",
        points: [
          "Wearable and implantable health monitoring",
          "Soft-robot sense–actuate integration",
          "Neural interfaces and rehabilitation",
        ],
      },
    },
  ],
};

const tree = isEn ? treeEn : treeZh;

// 布局基础常量
const W = 1120;
const BW = 344;
const GAP = (W - BW * 3) / 4;
const ROOT_W = 580;
const ROOT_X = (W - ROOT_W) / 2;
const ROOT_Y = 28;
const ROOT_H = 92;
const BUS_Y = 168;
const BRANCH_Y = 236;
const BOTTOM_PAD = 16;

// 文字区样式
const TITLE_FS = 19;
const TITLE_LH = 23;
const COUNT_FS = 13;
const SUB_FS = 14.5;
const SUB_LH = 19;
const SUB_GAP = 7;
const PUB_FS = 14;
const PUB_LH = 21;

const SUB_MAX_W = BW - 38 - 16;   // 290
const TITLE_MAX_W = BW - 40;       // 304

const xs = tree.branches.map((_, i) => GAP + i * (BW + GAP));
const centers = tree.branches.map((_, i) => xs[i] + BW / 2);

// ---- 逐方向计算纵向布局（标题 → 成员数 → 子方向 → 团队成员 → 发表论文）----
tree.branches.forEach((b, i) => {
  const col = palette[i];
  b.color = col;

  const names = namesFor(treeZh.branches[i].title);
  b.count = names.length;

  // 成员 pill
  const chips: { x: number; y: number; w: number; label: string }[] = [];
  let cx = 18;
  let cy = 0;
  let maxY = 0;
  names.forEach((n) => {
    const w = chipWidth(n);
    if (cx + w > 18 + BW_CONTENT && chips.length > 0) {
      cx = 18;
      cy += CHIP_H + CHIP_GAP_Y;
      maxY = cy;
    }
    chips.push({ x: cx, y: cy, w, label: n });
    cx += w + CHIP_GAP_X;
  });
  b.chips = chips;
  b.chipRows = names.length ? maxY / (CHIP_H + CHIP_GAP_Y) + 1 : 0;


  // 代表论文
  const pubItems = pubsFor(treeZh.branches[i].title).map(pubLabel);
  b.pubLines = wrapPubs(pubItems);

  // 标题与子方向折行
  b.titleLines = wrapLabel(b.title, TITLE_MAX_W, TITLE_FS);
  b.subWrapped = b.sub.map((s) => wrapLabel(s, SUB_MAX_W, SUB_FS));

  // 纵向游标
  let y = 0;
  b.titleY = 34;
  y = b.titleY + b.titleLines.length * TITLE_LH;
  b.countY = y + 2;
  y = b.countY + 18;
  b.subPositions = b.subWrapped.map((lines) => {
    const pos = { y, lines };
    y += lines.length * SUB_LH + SUB_GAP;
    return pos;
  });
  const subBottom = y - SUB_GAP;
  b.dividerY = subBottom + 12;
  b.labelY = b.dividerY + 24;
  const chipsTop = b.labelY + 12;
  b.chipsTop = chipsTop;

  // 预渲染成员 pill 为 SVG 字符串，用 set:html 注入，规避 Astro 编译器对
  // “.map 返回含 <text> 动态子节点的 <g>”少输出一个括号的边界 bug。
  b.chipsSvg = chips
    .map(
      (c) =>
        `<g>` +
        `<rect x="${c.x}" y="${b.chipsTop + c.y}" width="${c.w}" height="${CHIP_H}" rx="${CHIP_H / 2}" fill="${col.soft}" stroke="${col.main}" stroke-opacity="0.45" stroke-width="1"/>` +
        `<text x="${c.x + c.w / 2}" y="${b.chipsTop + c.y + CHIP_H / 2 + 4.5}" text-anchor="middle" fill="${col.main}" font-size="${CHIP_FONT}" font-weight="600">${c.label}</text>` +
        `</g>`
    )
    .join("");

  const chipsBottom = chipsTop + (b.chipRows > 0 ? b.chipRows * CHIP_H + (b.chipRows - 1) * CHIP_GAP_Y : 0);
  let bottom = chipsBottom;
  if (b.pubLines.length > 0) {
    b.pubsDividerY = chipsBottom + 16;
    b.pubsLabelY = b.pubsDividerY + 24;
    b.pubsTop = b.pubsLabelY + 20;
    bottom = b.pubsTop + b.pubLines.length * PUB_LH;
  }
  b.bottom = bottom + BOTTOM_PAD;
});

// ---- 应用场景行布局 ----
const SCEN_LEAD_Y = 28;
const SCEN_LEAD_LH = 20;
const SCEN_POINT_LH = 21;
const SCEN_POINT_GAP = 6;
tree.branches.forEach((b) => {
  b.scenLeadLines = wrapLabel(b.scenario.lead, BW - 40, 15.5);
  let py = SCEN_LEAD_Y + b.scenLeadLines.length * SCEN_LEAD_LH + 8;
  b.scenPointPos = b.scenario.points.map((p) => {
    const lines = wrapLabel(p, BW - 42, 14);
    const pos = { y: py, lines };
    py += lines.length * SCEN_POINT_LH + SCEN_POINT_GAP;
    return pos;
  });
  b.scenH = py + 10;
});

const maxBranchH = Math.max(...tree.branches.map((b) => b.bottom));
const SCEN_BOX_H = Math.max(...tree.branches.map((b) => b.scenH));
const SCEN_LABEL_Y = BRANCH_Y + maxBranchH + 44;
const SCEN_BOX_Y = SCEN_LABEL_Y + 30;
const H = SCEN_BOX_Y + SCEN_BOX_H + 28;
---

<svg
  class="dir-tree"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={isEn ? 'Research architecture diagram' : '研究方向架构图'}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="rootGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#16458a" />
      <stop offset="100%" stop-color="#2b6fb5" />
    </linearGradient>
    <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#1f2d3d" flood-opacity="0.14" />
    </filter>
    <filter id="lightShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#1f2d3d" flood-opacity="0.10" />
    </filter>
  </defs>

  <!-- background panel -->
  <rect x="0" y="0" width={W} height={H} rx="18" fill="#f7f9fc" stroke="#eaeef4" stroke-width="1" />

  <!-- connectors -->
  <g stroke={LINE} stroke-width="2.5" fill="none" stroke-linecap="round">
    <line x1={W / 2} y1={ROOT_Y + ROOT_H} x2={W / 2} y2={BUS_Y} />
    <line x1={centers[0]} y1={BUS_Y} x2={centers[centers.length - 1]} y2={BUS_Y} />
    {centers.map((cx) => <line x1={cx} y1={BUS_Y} x2={cx} y2={BRANCH_Y} />)}
    {centers.map((cx) => <line x1={cx} y1={BRANCH_Y + maxBranchH} x2={cx} y2={SCEN_BOX_Y} />)}
  </g>
  <!-- connector nodes -->
  <g fill={PRIMARY}>
    <circle cx={W / 2} cy={BUS_Y} r="4.5" />
    {centers.map((cx) => <circle cx={cx} cy={BUS_Y} r="4.5" />)}
    {centers.map((cx) => <circle cx={cx} cy={BRANCH_Y} r="4.5" />)}
  </g>

  <!-- root node -->
  <g filter="url(#softShadow)">
    <rect x={ROOT_X} y={ROOT_Y} width={ROOT_W} height={ROOT_H} rx="14" fill="url(#rootGrad)" />
  </g>
  <text x={W / 2} y={ROOT_Y + 42} text-anchor="middle" fill="#fff" font-size="30" font-weight="700">
    {tree.root.title}
  </text>
  <text x={W / 2} y={ROOT_Y + 72} text-anchor="middle" fill="#dbe7f6" font-size="17">
    {tree.root.sub}
  </text>

  <!-- three direction boxes -->
  {
    tree.branches.map((b, i) => {
      const col = b.color;
      return (
        <g transform={`translate(${xs[i]}, ${BRANCH_Y})`}>
          <g filter="url(#lightShadow)">
            <rect x="0" y="0" width={BW} height={b.bottom} rx="14" fill="#fff" stroke={col.main} stroke-width="1.5" />
          </g>
          {/* 顶部色条 */}
          <path d={`M0 14 Q0 0 14 0 L${BW - 14} 0 Q${BW} 0 ${BW} 14 L${BW} 6 L0 6 Z`} fill={col.main} />
          {/* 标题区 */}
          <text x="20" y={b.titleY} fill={col.main} font-size={TITLE_FS} font-weight="700">
            {b.titleLines.map((ln, k) => <tspan x="20" y={b.titleY + k * TITLE_LH}>{ln}</tspan>)}
          </text>
          <text x="20" y={b.countY} fill={MUTED} font-size={COUNT_FS}>{b.count}{isEn ? ' members' : ' 名成员'}</text>

          {/* 子方向 */}
          {b.subPositions.map((it) => (
            <g transform={`translate(0, ${it.y})`}>
              <circle cx="24" cy="5" r="4.5" fill={col.main} />
              <text x="38" y="11" fill={DARK} font-size={SUB_FS}>
                {it.lines.map((ln, k) => <tspan x="38" y={11 + k * SUB_LH}>{ln}</tspan>)}
              </text>
            </g>
          ))}

          {/* 团队成员 */}
          <line x1="16" y1={b.dividerY} x2={BW - 16} y2={b.dividerY} stroke={LINE} stroke-width="1" />
          <text x="18" y={b.labelY} fill={col.main} font-size="16" font-weight="700">{isEn ? 'Team' : '团队成员'}</text>
          <g class="chips" set:html={b.chipsSvg}></g>

          {/* 发表论文 */}
          {b.pubLines.length > 0 && (
            <g>
              <line x1="16" y1={b.pubsDividerY} x2={BW - 16} y2={b.pubsDividerY} stroke={LINE} stroke-width="1" />
              <text x="18" y={b.pubsLabelY} fill={col.main} font-size="16" font-weight="700">{isEn ? 'Publications' : '发表论文'}</text>
              {b.pubLines.map((line, k) => (
                <text x="18" y={b.pubsTop + k * PUB_LH} fill={DARK} font-size={PUB_FONT}>{line.join(PUB_SEP)}</text>
              ))}
            </g>
          )}
        </g>
      );
    })
  }

  {/* 应用场景行 */}
  <text x={W / 2} y={SCEN_LABEL_Y} text-anchor="middle" fill="#334155" font-size="21" font-weight="700">{isEn ? 'Applications' : '应用场景'}</text>
  {
    tree.branches.map((b, i) => {
      const col = b.color;
      return (
        <g transform={`translate(${xs[i]}, ${SCEN_BOX_Y})`}>
          <g filter="url(#lightShadow)">
            <rect x="0" y="0" width={BW} height={SCEN_BOX_H} rx="14" fill={col.soft2} stroke={col.main} stroke-width="1.5" />
          </g>
          <line x1="15" y1="16" x2="15" y2={SCEN_BOX_H - 16} stroke={col.main} stroke-width="3.5" stroke-linecap="round" />
          <text x="28" y={SCEN_LEAD_Y} fill={col.main} font-size="15.5" font-weight="700">
            {b.scenLeadLines.map((ln, k) => <tspan x="28" y={SCEN_LEAD_Y + k * SCEN_LEAD_LH}>{ln}</tspan>)}
          </text>
          {b.scenPointPos.map((it) => (
            <g transform={`translate(0, ${it.y})`}>
              <circle cx="32" cy="5" r="3.5" fill={col.main} />
              <text x="42" y="11" fill={DARK} font-size="14">
                {it.lines.map((ln, k) => <tspan x="42" y={11 + k * SCEN_POINT_LH}>{ln}</tspan>)}
              </text>
            </g>
          ))}
        </g>
      );
    })
  }
</svg>

<style>
  .dir-tree {
    width: 100%;
    height: auto;
    max-width: 1040px;
    margin: 8px auto 8px;
    display: block;
  }
</style>
