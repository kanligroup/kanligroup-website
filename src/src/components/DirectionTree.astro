---
// 研究方向架构图：核心科学问题为根，分三个方向；
// 每个方向框内列出子方向与团队成员（以彩色 pill 呈现）；底部「应用场景」一行对应三个方向。
// 成员与人数均从 members collection 动态计算，避免与页面其它处不一致。
import { getCollection } from 'astro:content';

const PRIMARY = "#1a4d8f";
const LINE = "#c2cedd";
const DARK = "#1f2d3d";
const MUTED = "#5b6b7b";

// 三个方向各自的配色（蓝 / 青绿 / 紫），用于顶条、子项圆点、成员 pill、应用场景强调
const palette = [
  { main: "#1a4d8f", soft: "#eaf1fa", soft2: "#f5f9fd" },
  { main: "#0f6e58", soft: "#e6f2ef", soft2: "#f3faf8" },
  { main: "#7c3aed", soft: "#f1ebfd", soft2: "#faf7fe" },
];

const members = await getCollection('members');

// 按方向取在读学生姓名（不含 PI）
const namesFor = (title: string) =>
  members
    .filter((m) => m.data.direction === title && !m.data.is_pi)
    .map((m) => m.data.name);

// 长句按字符换行（应用场景）
function wrapChars(str: string, max: number): string[] {
  const lines: string[] = [];
  let cur = '';
  for (const ch of str) {
    cur += ch;
    if (cur.length >= max) {
      lines.push(cur);
      cur = '';
    }
  }
  if (cur) lines.push(cur);
  return lines;
}

// 成员 pill 布局：贪心换行
const CHIP_FONT = 12.5;
const CHIP_PAD_X = 11;
const CHIP_H = 24;
const CHIP_GAP_X = 7;
const CHIP_GAP_Y = 7;
const BW_CONTENT = 308; // 框内可用宽度

function chipWidth(name: string): number {
  return name.length * CHIP_FONT + CHIP_PAD_X * 2;
}

const tree = {
  root: { title: "核心科学问题", sub: "以理论与应用力学为统摄 · 柔性载体上的分布式感知" },
  branches: [
    {
      title: "柔性电子微飞行器",
      sub: [
        "仿生三维微飞行器结构设计",
        "飞行力学与主动调控",
        "感知–通信–驱动一体化系统集成",
        "无线组网与低功耗图传",
        "旋翼健康监测",
      ],
      scenario:
        "空地协同的分布式感知节点：面向灾害救援、精准农业与狭窄空间的群体监测，构成 Physical AI 的空间感知前端。",
    },
    {
      title: "耐高温柔性多模态传感器",
      sub: [
        "多参量分布式感知",
        "压力阵列化感知",
        "纳米尺度效应及原位感知",
        "柔性PZT薄膜压电传感",
        "柔性多模态传感",
        "柔性蒙皮",
      ],
      scenario:
        "极端环境下的结构健康监测：航空发动机与燃机热端部件、复杂曲面蒙皮的共形多参量感知与装备预测性维护。",
    },
    {
      title: "柔性智能微系统",
      sub: [
        "摩擦纳米发电机纤维",
        "柔性混合传感与无线定位",
        "模块化柔性机器人与软体驱动",
        "侵入式脑机接口",
      ],
      scenario:
        "人–机–环融合的智能终端：可穿戴/植入式健康监测、软体机器人感知–驱动一体与神经接口康复。",
    },
  ],
};

// 补全每个分支：配色、成员 pill 布局、场景换行
const SCEN_MAX = 16;
tree.branches.forEach((b, i) => {
  const names = namesFor(b.title);
  b.count = names.length;
  b.color = palette[i];

  b.scenarioLines = wrapChars(b.scenario, SCEN_MAX);

  const chips: { x: number; y: number; w: number; label: string }[] = [];
  let cx = 18;
  let cy = 0;
  let maxY = 0;
  names.forEach((n) => {
    const w = chipWidth(n);
    if (cx + w > 18 + BW_CONTENT && chips.length > 0) {
      cx = 18;
      cy += CHIP_H + CHIP_GAP_Y;
      maxY = cy;
    }
    chips.push({ x: cx, y: cy, w, label: n });
    cx += w + CHIP_GAP_X;
  });
  b.chips = chips;
  b.chipRows = names.length ? maxY / (CHIP_H + CHIP_GAP_Y) + 1 : 0;
});

// 布局常量
const W = 1120;
const BW = 344;
const GAP = (W - BW * 3) / 4;
const ROOT_W = 580;
const ROOT_X = (W - ROOT_W) / 2;
const ROOT_Y = 28;
const ROOT_H = 92;
const BUS_Y = 168;
const BRANCH_Y = 236;
const HEADER_H = 60;
const SUB_ITEM_H = 27;
const FIRST_SUB_BASE = HEADER_H + 25;   // 第一个子方向文字基线
const DIVIDER_OFF = 10;
const LABEL_OFF = 26;                    // 「团队成员」相对分隔线的偏移
const BOTTOM_PAD = 16;

const xs = tree.branches.map((_, i) => GAP + i * (BW + GAP));
const centers = tree.branches.map((_, i) => xs[i] + BW / 2);

const heights = tree.branches.map((b) => {
  const dividerY = HEADER_H + b.sub.length * SUB_ITEM_H + DIVIDER_OFF;
  const labelY = dividerY + LABEL_OFF;
  const chipsTop = labelY + 12;
  const chipsBottom = chipsTop + (b.chipRows > 0 ? b.chipRows * CHIP_H + (b.chipRows - 1) * CHIP_GAP_Y : 0);
  return chipsBottom + BOTTOM_PAD;
});
const maxBranchH = Math.max(...heights);

// 应用场景行
const SCEN_LABEL_Y = BRANCH_Y + maxBranchH + 44;
const SCEN_BOX_Y = SCEN_LABEL_Y + 30;
const maxScenLines = Math.max(...tree.branches.map((b) => b.scenarioLines.length));
const SCEN_BOX_H = 18 + maxScenLines * 23 + 18;

const H = SCEN_BOX_Y + SCEN_BOX_H + 28;
---

<svg
  class="dir-tree"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="研究方向架构图"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="rootGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#16458a" />
      <stop offset="100%" stop-color="#2b6fb5" />
    </linearGradient>
    <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#1f2d3d" flood-opacity="0.14" />
    </filter>
    <filter id="lightShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#1f2d3d" flood-opacity="0.10" />
    </filter>
  </defs>

  <!-- 背景面板 -->
  <rect x="0" y="0" width={W} height={H} rx="18" fill="#f7f9fc" stroke="#eaeef4" stroke-width="1" />

  <!-- 连接线 -->
  <g stroke={LINE} stroke-width="2.5" fill="none" stroke-linecap="round">
    <line x1={W / 2} y1={ROOT_Y + ROOT_H} x2={W / 2} y2={BUS_Y} />
    <line x1={centers[0]} y1={BUS_Y} x2={centers[centers.length - 1]} y2={BUS_Y} />
    {centers.map((cx) => <line x1={cx} y1={BUS_Y} x2={cx} y2={BRANCH_Y} />)}
    {centers.map((cx) => <line x1={cx} y1={BRANCH_Y + maxBranchH} x2={cx} y2={SCEN_BOX_Y} />)}
  </g>
  <!-- 连接节点圆点 -->
  <g fill={PRIMARY}>
    <circle cx={W / 2} cy={BUS_Y} r="4.5" />
    {centers.map((cx) => <circle cx={cx} cy={BUS_Y} r="4.5" />)}
    {centers.map((cx) => <circle cx={cx} cy={BRANCH_Y} r="4.5" />)}
  </g>

  <!-- 根节点 -->
  <g filter="url(#softShadow)">
    <rect x={ROOT_X} y={ROOT_Y} width={ROOT_W} height={ROOT_H} rx="14" fill="url(#rootGrad)" />
  </g>
  <text x={W / 2} y={ROOT_Y + 40} text-anchor="middle" fill="#fff" font-size="26" font-weight="700">
    {tree.root.title}
  </text>
  <text x={W / 2} y={ROOT_Y + 68} text-anchor="middle" fill="#dbe7f6" font-size="15">
    {tree.root.sub}
  </text>

  <!-- 三个方向框 -->
  {
    tree.branches.map((b, i) => {
      const col = b.color;
      const dividerY = HEADER_H + b.sub.length * SUB_ITEM_H + DIVIDER_OFF;
      const labelY = dividerY + LABEL_OFF;
      const chipsTop = labelY + 12;
      return (
        <g transform={`translate(${xs[i]}, ${BRANCH_Y})`}>
          <g filter="url(#lightShadow)">
            <rect x="0" y="0" width={BW} height={heights[i]} rx="14" fill="#fff" stroke={col.main} stroke-width="1.5" />
          </g>
          <!-- 顶部色条 -->
          <path d={`M0 14 Q0 0 14 0 L${BW - 14} 0 Q${BW} 0 ${BW} 14 L${BW} 6 L0 6 Z`} fill={col.main} />
          <!-- 标题区 -->
          <text x="20" y="34" fill={col.main} font-size="19" font-weight="700">{b.title}</text>
          <text x="20" y="52" fill={MUTED} font-size="13.5">{b.count} 名成员</text>

          <!-- 子方向 -->
          {b.sub.map((s, j) => (
            <g transform={`translate(0, ${FIRST_SUB_BASE - 5 + j * SUB_ITEM_H})`}>
              <circle cx="24" cy="5" r="4" fill={col.main} />
              <text x="38" y="10" fill={DARK} font-size="15">{s}</text>
            </g>
          ))}

          <!-- 分隔线 -->
          <line x1="16" y1={dividerY} x2={BW - 16} y2={dividerY} stroke={LINE} stroke-width="1" />
          <!-- 团队成员 -->
          <text x="18" y={labelY} fill={col.main} font-size="13.5" font-weight="700">团队成员</text>
          {b.chips.map((c) => (
            <g>
              <rect x={c.x} y={chipsTop + c.y} width={c.w} height={CHIP_H} rx={CHIP_H / 2} fill={col.soft} stroke={col.main} stroke-width="1" stroke-opacity="0.45" />
              <text x={c.x + c.w / 2} y={chipsTop + c.y + CHIP_H / 2 + 4.5} text-anchor="middle" fill={col.main} font-size={CHIP_FONT} font-weight="600">{c.label}</text>
            </g>
          ))}
        </g>
      );
    })
  }

  <!-- 应用场景行 -->
  <text x={W / 2} y={SCEN_LABEL_Y} text-anchor="middle" fill="#334155" font-size="18" font-weight="700">应用场景</text>
  {
    tree.branches.map((b, i) => {
      const col = b.color;
      return (
        <g transform={`translate(${xs[i]}, ${SCEN_BOX_Y})`}>
          <g filter="url(#lightShadow)">
            <rect x="0" y="0" width={BW} height={SCEN_BOX_H} rx="14" fill={col.soft2} stroke={col.main} stroke-width="1.5" />
          </g>
          <line x1="15" y1="16" x2="15" y2={SCEN_BOX_H - 16} stroke={col.main} stroke-width="3.5" stroke-linecap="round" />
          {b.scenarioLines.map((ln, k) => (
            <text x="28" y={24 + k * 23} fill={DARK} font-size="14">{ln}</text>
          ))}
        </g>
      );
    })
  }
</svg>

<style>
  .dir-tree {
    width: 100%;
    height: auto;
    max-width: 1040px;
    margin: 8px auto 8px;
    display: block;
  }
</style>
